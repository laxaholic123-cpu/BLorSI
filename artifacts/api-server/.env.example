# BAD LUCK OR SKILL ISSUE? — API server environment
#
# Copy to .env (gitignored) and fill in. The server only exists to run the
# Catan board-scan vision call; everything else in the app is offline.

# --- Vision provider (required for board scan) ---
# An API key for an OpenAI-compatible endpoint.
AI_INTEGRATIONS_OPENAI_API_KEY=

# Leave unset to talk to api.openai.com directly. Set it to point at a gateway
# or proxy instead. NOTE: the Replit AI gateway URL this project used to depend
# on only resolves from inside Replit — it will not work locally.
# AI_INTEGRATIONS_OPENAI_BASE_URL=

# Vision model to call. Must be a model your key and base URL can actually
# reach; the previous hardcoded value was gateway-specific.
# BOARD_SCAN_MODEL=gpt-4o

# --- Board scan limits ---
# Give up on the vision call after this long (ms). Keeps players from being
# stranded on the "Reading the board…" spinner.
# BOARD_SCAN_TIMEOUT_MS=45000

# Per-client throttle. Every scan costs money at the provider, so an
# unthrottled public endpoint is a way to run up a bill.
# BOARD_SCAN_RATE_WINDOW_MS=60000
# BOARD_SCAN_RATE_MAX=10

# --- Networking ---
# Comma-separated browser origins allowed to call the API. Unset allows all,
# which is correct for local development. The native app sends no Origin header,
# so setting this never affects it.
# ALLOWED_ORIGINS=https://example.com,https://www.example.com

# Set when running behind a reverse proxy, so req.ip is the real client and the
# rate limiter does not see every request as one address. Accepts the same
# values as Express's "trust proxy" setting (e.g. 1, or a CIDR).
# TRUST_PROXY=1

# Port to listen on (defaults to 3000).
# PORT=3000

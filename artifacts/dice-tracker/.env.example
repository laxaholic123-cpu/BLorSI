# BAD LUCK OR SKILL ISSUE? — Environment Variables
#
# No environment variables are required for local development.
# The app runs fully offline with AsyncStorage.
#
# Copy this file to .env.local and fill in values when cloud features are added.

# --- Future: Cloud sync (Phase 7+) ---
# EXPO_PUBLIC_API_URL=https://api.example.com

# --- Expo build config (set automatically by the dev workflow) ---
# EXPO_PUBLIC_DOMAIN=<your-replit-dev-domain>
# EXPO_PUBLIC_REPL_ID=<your-repl-id>

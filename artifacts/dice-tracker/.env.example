# BAD LUCK OR SKILL ISSUE? — Mobile app environment
#
# Copy this file to .env.local (gitignored) and fill in values.
#
# The app runs fully offline on AsyncStorage. The ONLY thing that needs network
# access is the Catan board-scan photo feature, which calls the api-server.
#
# IMPORTANT: everything prefixed EXPO_PUBLIC_ is compiled into the app bundle
# and readable by anyone who unpacks the APK. Never put a secret here.

# --- Board scan (optional — the rest of the app works without it) ---
# Host running the api-server. buildBoardScanUrl() turns this into
#   https://<domain>/api-server/api/board-scan/analyze
#
# On a real device this must be reachable FROM THE PHONE, so localhost will not
# work — use your machine's LAN address, a tunnel, or a deployed host.
# EXPO_PUBLIC_DOMAIN=192.168.1.50:3000

# Left over from the Replit setup; unused by the app itself.
# EXPO_PUBLIC_REPL_ID=
